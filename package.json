{
  "name": "xvant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile=.artifacts/tests.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages apps scripts tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate": "node scripts/gate.mjs",
    "probe": "node scripts/probe.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "release:check": "node scripts/release-check.mjs",
    "audit:release": "node scripts/audit.mjs",
    "check:clean-install": "node scripts/clean-install-check.mjs",
    "soak": "node scripts/soak.mjs",
    "package:release": "node scripts/package-release.mjs",
    "probe:live:opencode": "node scripts/opencode-live.mjs",
    "demo": "node --experimental-strip-types apps/controller/src/demo.ts",
    "demo:durable": "node apps/controller/src/durable-demo.ts",
    "xvant": "node scripts/xvant.mjs",
    "routing": "node scripts/routing.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  },
  "packageManager": "npm@12.0.2"
}
