* text=auto eol=lf
# cmd.exe reads batch files most reliably with CRLF.
*.cmd text eol=crlf

# Evidence bundles are verified by exact byte hashes; never convert line endings.
docs/evidence/runs/** -text
docs/evidence/a00/** -text
# Raw terminal logs include carriage-return progress output; preserve as artifacts.
docs/evidence/a00/*.log -diff
